#!/bin/sh
# A merge driver for a derived artifact, which is a file that no branch wrote by
# hand and that no merge may reconcile.
#
# Install once per clone, beside the hook path the pre-commit gate needs:
#     git config merge.headwater-regenerate.name "regenerate a derived artifact"
#     git config merge.headwater-regenerate.driver ".githooks/merge-regenerate %O %A %B %P"
#
# `.gitattributes` names the files this covers and says why each one is on the
# list. Both halves are needed: the attribute selects the file, and the config
# above supplies the driver, which git deliberately does not read from a
# repository because a driver is an executable a clone would otherwise run
# without being asked.
#
# # Why this refuses rather than merges
#
# Every file this driver covers holds a fold: a count over the whole corpus, or
# a digest over the whole canonical text. A fold does not survive a merge. Two
# branches that each add one document both rewrite the same total to the same
# value, and a three-way merge reads one change written twice rather than two
# changes. It takes that value with no conflict, and the result is a number that
# was true on neither branch and is true of nothing.
#
# A record that decomposes into one line per entity has no such problem, and
# where decomposing is affordable this repository decomposes instead of coming
# here: `engine/crates/census/fixtures/corpus.census` holds one record per file
# and no total for exactly this reason. This driver is for the folds where that
# is not affordable, and `corpus.checks` is the case that names the cost — one
# record per check instance would be a five-thousand-line file that moves on
# every commit.
#
# # Why it does not regenerate, given the name
#
# The obvious driver runs the generator and writes the answer. It cannot, and
# the reason is worth stating rather than discovering. A merge driver runs
# *during* the merge, one path at a time, over a working tree in which the other
# paths have not all been merged yet. A whole-corpus artifact regenerated at that
# moment describes a tree that never existed and will not exist when the merge
# finishes. It would be wrong in a new way and, unlike the silent merge above, it
# would look authoritative.
#
# So this leaves our version in place, marks the path conflicted by exiting
# non-zero, and names the one command that resolves it. Git writes no conflict
# markers for a custom driver, so the file stays readable and the resolution is
# to run the command and stage the result. That is one deterministic step, and
# it never produces a file that no tree agrees with.
#
# # What this reaches, and what it does not
#
# **It reaches two branches that moved a fold to different values, and never two
# branches that moved it to the same value.** A merge driver is a content merge,
# so git compares the two blobs first and resolves a path with one blob at the
# tree level, consulting nothing. Two branches that each add a document of one
# kind measure the same figures and write one identical page, so the case this
# driver was written for is the case it is not called for.
#
# That is not a defect in this file and no wider driver would cure it. What cures
# it is a check on the merged state, which is what
# [HW-DR-0049](../docs/decisions/0049-a-corpus-wide-fold-is-derived-and-never-stored.md)
# asks for and what this refusal is the fallback to: `.githooks/commit-msg` runs
# `.githooks/merged-fold-check` whenever a merge is in progress, and that runs the
# producers of these paths against the tree the merge produced.
# `.gitattributes` says which of the declared paths two branches can write alike,
# measured. `engine/crates/census/tests/merge_driver.rs` holds both halves in one
# case table.
#
# Neither half reaches the merge button on the forge, which runs nothing from
# this repository. The pull-request run over `refs/pull/N/merge` is what covers
# that, and only while the branch is current with `main`.

ours="$2"
theirs="$3"
path="$4"
site_non_figure_diff=

normalize_site_figures() {
    sed -E 's/(data-figure="[^"]*">)[^<]*(<)/\1__HEADWATER_FIGURE__\2/g' "$1"
}

case "$path" in
  .headwater/corpus.json|.headwater/export.json|.headwater/nav.yml|docs/*)
    remedy="headwater generate    (CI holds it with: headwater generate --check)"
    ;;
  site/*)
    # These pages are mixed: hand-written prose and markup, plus measured
    # `data-figure` spans. Refreshing figures is still needed, but it cannot by
    # itself reconcile prose and markup that differ between the two sides.
    # That is why this does not reduce to #675's two options: treating the page
    # as one regenerated artifact discards hand edits, and refusing every
    # figure-adjacent merge would stop ordinary same-day page work.
    remedy="review prose/markup changes, then run sh tools/site/refresh-figures.sh    (CI holds it with: sh tools/site/refresh-figures.sh --check)"
    if test -f "$ours" && test -f "$theirs"; then
        ours_normalized=$(mktemp)
        theirs_normalized=$(mktemp)
        normalize_site_figures "$ours" >"$ours_normalized"
        normalize_site_figures "$theirs" >"$theirs_normalized"
        if ! cmp -s "$ours_normalized" "$theirs_normalized"; then
            site_non_figure_diff=$(diff -u "$ours_normalized" "$theirs_normalized" || true)
        fi
        rm -f "$ours_normalized" "$theirs_normalized"
    fi
    ;;
  .headwater/taxonomy.lock)
    remedy="headwater taxonomy resolve --write    (CI holds it with: headwater taxonomy resolve --check)"
    ;;
  engine/crates/*/fixtures/*)
    crate=$(printf '%s' "$path" | sed -n 's|engine/crates/\([^/]*\)/fixtures/.*|\1|p')
    remedy="HEADWATER_BLESS=1 cargo test -p headwater-$crate --test fixtures --manifest-path engine/Cargo.toml"
    ;;
  *)
    remedy="regenerate this artifact from its source and stage the result"
    ;;
esac

# The message goes to standard error, because standard output during a merge is
# git's. A driver that printed nothing would leave a conflict whose cause is
# invisible: the file has no markers in it, so there is nothing in the working
# tree for a reader to find.
cat >&2 <<EOF

  $path is a derived artifact, and this merge did not reconcile it.

  It holds a fold over the whole corpus. Both sides moved the same number, so
  a merge of the two would have produced a value true of neither tree. Our
  version is left in place and the path is marked conflicted.

  Finish the merge, then regenerate and stage it:

      $remedy
      git add $path

EOF

if [ -n "$site_non_figure_diff" ]; then
cat >&2 <<EOF
  WARNING: non-figure prose/markup differs between %A and %B for $path.
  Refreshing figures alone keeps one side's prose and can drop the other side.
  Carry forward the intended prose/markup first, then refresh figures.

  Non-figure diff after normalizing every data-figure span:

EOF
printf '%s\n' "$site_non_figure_diff" | sed 's/^/  /' >&2
printf '\n' >&2
fi

# Our version stands, unmodified. Exit non-zero so that git records a conflict
# rather than accepting it.
test -f "$ours" && exit 1
exit 1

#!/bin/sh
# The one position that sees a `git rebase` land, because nothing else does.
#
# `.githooks/commit-msg` is the gate on a merge: it runs whenever `MERGE_HEAD`
# is present, which covers `git merge` and `git merge --continue` but, by its
# own comment, reaches a rebase "not at all" — a rebase replays each commit
# with `git commit`, and no `MERGE_HEAD` is ever written for it. So the same
# `.githooks/merge-regenerate` conflict on a `site/*` page that a merge gates
# a second time can pass a rebase with only the driver's own refusal in the
# way, resolved once and never checked again.
#
# `post-rewrite` is what git runs after `git rebase` and `git commit --amend`
# finish rewriting history — the two operations `commit-msg` misses. It cannot
# refuse anything: by the time it runs, the rewrite already succeeded and the
# new commits already exist. What it can do is make a pending review
# impossible to miss the moment the rebase that caused it ends, rather than
# leaving it for whoever next reads `.githooks/merge-regenerate`'s stderr
# scroll past, or for `.githooks/pre-push` to be the first thing that ever
# mentions it.
#
# Install once per clone, the same command every hook here needs:
#     git config core.hooksPath .githooks

# `git rev-parse --show-toplevel` rather than `dirname "$0")/..`: an absolute
# `core.hooksPath` (the value `EnterWorktree` writes, per `CLAUDE.md`) would
# otherwise resolve this into the main checkout's `tools/`, and the marker
# this reads is the current worktree's own, not the main checkout's.
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$root" ] || exit 0

# `core.hooksPath` is shared by every worktree of a clone, and an absolute
# value names one checkout, so git resolves this hook to that checkout's copy
# whatever branch just finished rewriting. `.githooks/pre-commit` carries the
# full account of why and how this hands off to the worktree's own copy
# instead (#925), which is the same reason `$root` above reads
# `--show-toplevel` rather than this file's own directory.
#
# Parameter expansion rather than `dirname`/`basename`: the reduced `PATH`
# `.githooks/fixtures.sh` builds for the `pre-push` case beside this one
# carries neither, and a handoff that needed them would fail closed there.
case $0 in
    */*) hook_dir=${0%/*} ;;
    *) hook_dir=. ;;
esac
hook_name=${0##*/}
self=$(cd "$hook_dir" 2>/dev/null && pwd -P)
own_dir=$(cd "$root/.githooks" 2>/dev/null && pwd -P)
if [ -z "${HEADWATER_HOOK_HANDOFF:-}" ] && [ "$self" != "$own_dir" ]; then
    own="$root/.githooks/$hook_name"
    if [ -x "$own" ]; then
        HEADWATER_HOOK_HANDOFF=1 exec "$own" "$@"
    fi
    echo "headwater: this worktree carries no $hook_name of its own, so the" >&2
    echo "  checkout core.hooksPath names ran its copy instead." >&2
fi

pending=$(sh "$root/tools/site/ack-site-prose-reviewed.sh" 2>/dev/null)
[ -n "$pending" ] || exit 0

cat >&2 <<EOF

  This rebase left a site/* merge conflict resolved but not reviewed:

$pending

  sh tools/site/ack-site-prose-reviewed.sh <path> shows the diff again and
  clears it once you have carried the losing side's prose forward by hand.
  Until then, .githooks/pre-push refuses to push any ref from this clone.

EOF

exit 0

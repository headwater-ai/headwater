#!/bin/sh
# The caller: a git range, handed to `headwater change`.
#
#     .githooks/change-manifest <base-rev> <out-dir>
#
# It prints the path of the manifest `headwater change` wrote on standard
# output, and it exits with that verb's own status.
#
# # Why this is argument translation now, and was git plumbing before
#
# Until [#929](https://github.com/headwater-ai/headwater/issues/929), every
# `git` command between a commit and a manifest lived in this file, because
# `engine/crates/check/src/change.rs` states the boundary the check-evaluation
# path holds to — it "walks no history, it runs no version control tool, and
# it opens no file that the caller did not name" — and nothing else in the
# binary ran one either. [HW-DR-0072](../docs/decisions/0072-the-binary-is-the-only-interface-an-adopter-must-run-and-every-integration-point-outside-it-is-declared.md)
# ruled that gap a defect: an adopter with no shell script of their own could
# never produce a manifest, because this file was the only producer that
# existed, and it belonged to this repository alone. `headwater change` is
# the verb #929 adds, and `engine/crates/vcs` is the one crate of the
# workspace that now runs `git diff`, `git show` and `git ls-files` — outside
# the check-evaluation path, on the same terms this file always ran them.
#
# What is left here is finding the built engine and handing the two arguments
# over, the same translation `.githooks/pre-commit` already does for `check`
# itself. This file stays, rather than pointing every caller straight at the
# binary, because `.githooks/pre-commit`, `.githooks/fixtures.sh` and the CI
# job all name it by this path, and a caller of a git hook should not have to
# know which of two build profiles produced the engine it hands off to.
#
# # The two anchors, unchanged
#
# Spec 12 fixes what `prior` is anchored to and names two: the committed `HEAD`
# for a working-tree hook, and the merge base for a proposed change. Both are a
# revision, and the side that is compared against it is the working tree in
# both cases. `.githooks/pre-commit` passes `HEAD`; the CI job passes the base
# of the pull request. Neither caller changes for this file becoming thinner.

set -u

if [ $# -ne 2 ]; then
    echo "usage: change-manifest <base-rev> <out-dir>" >&2
    exit 2
fi
base=$1
out=$2

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "change-manifest: not inside a git repository." >&2
    exit 1
}

# The same two-profile lookup `.githooks/pre-commit` runs, restated here
# rather than sourced from it: this script is invoked as a caller in its own
# right (the CI job runs it directly, and so does `.githooks/fixtures.sh`),
# and it has always resolved its own `$root` independently for the same
# reason.
release="$root/engine/target/release/headwater"
dev_release="$root/engine/target/dev-release/headwater"
engine=
[ -x "$release" ] && engine=$release
if [ -x "$dev_release" ] && { [ -z "$engine" ] || [ "$dev_release" -nt "$engine" ]; }; then
    engine=$dev_release
fi
if [ -z "$engine" ]; then
    echo "change-manifest: no built engine, so this repository's own producer cannot run." >&2
    exit 1
fi

exec "$engine" change "$base" "$out" --root "$root"

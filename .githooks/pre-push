#!/bin/sh
# Two clauses. The first refuses a push whose tree CI would reject for a reason
# a second of local work finds: a Rust file `cargo fmt` would change, or a
# projection `headwater generate` would write. The second warns about an issue
# the push works on that nobody has claimed. Until #1273 a clause also refused a
# push while an unreviewed `site/*` resolution was pending; the pages merge as
# text now and the marker that clause read is gone.
#
# # The refusal: a format or a projection CI would reject
#
# A failed `Format` or `Every projection is what this corpus produces` step
# costs a push, a wait on the self-hosted pool that this host also builds on,
# and a second push (40 failed runs read on 2026-10-03: 7 Format, 7 projection).
# `.claude/agents/hw-build.md` already tells the build agent to run both, and 7
# Format failures happened anyway, which is HW-PD-0001's case: a sentence the
# performer does not reread needs a check rather than a reader.
#
# Both read the tree that is being pushed, so they run only when one of the
# refs in the push names `HEAD`; a push of another ref would be checked against
# the wrong tree, and so it is not checked. Both fail open with one line when the
# tool is missing, and with none when this is not a checkout with an engine at
# all. The projection check also skips when a source file under `engine/` is
# newer than the built engine, because an engine older than the change reads a
# stale answer as a defect of the tree. `HEADWATER_SKIP_PUSH_GATE=1` releases
# both for one push, and `--no-verify` releases the whole hook.
#
# # The warning: an issue this push works on that nobody has claimed
#
# `.claude/agents/hw-build.md` tells the build agent to assign the issue to
# itself and move it to In Progress before the first commit, and
# `.claude/agents/hw-queue.md` fixes that as the build agent's job alone so
# the claim is atomic and survives an agent that dies.
# [HW-PD-0004](../docs/process/decisions/0004-coordination-is-a-create-only-claim-and-authority-stays-on-the-tree.md)
# is why a claim lives on the board rather than in a coordinator's context.
#
# None of that reaches a session working an issue by hand, which never loads
# `hw-build.md`. That is the case
# [HW-PD-0001](../docs/process/decisions/0001-orchestration-prose-has-one-owner-per-sentence.md)
# closes with: the performer of the sentence is not its reader, so it needs a
# check rather than a reader. No prose home fixes it. `CLAUDE.md` is the file
# every agent pays for on every dispatch and most agents never touch the
# board, so the rule does not clear that bar.
#
# It warns and never refuses. An unclaimed issue is a board that has gone
# stale, and the push is not the thing that harmed it. It is also a clause
# that reaches the network, so every way that can go wrong — no
# `gh`, no login, no network, a rate limit, a number that is a pull request
# rather than an issue — is silence rather than a verdict. `gh auth status`
# reports a secondary rate limit as an invalid token, so no failure from `gh`
# is ever read as an answer about the board.
#
# Install once per clone, the same command every hook here needs:
#     git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$root" ] || exit 0

# `core.hooksPath` is shared by every worktree of a clone, and an absolute
# value names one checkout, so git resolves this hook to that checkout's copy
# whatever branch is actually pushing. `.githooks/pre-commit` carries the
# full account of why and how this hands off to the worktree's own copy
# instead (#925); this hook needs the same guard, because the branch being
# pushed is this worktree's and not the one an absolute value names. `exec`
# passes the ref list this hook reads on stdin
# through unchanged, because it replaces the process image without touching
# any open file descriptor.
#
# Parameter expansion rather than `dirname`/`basename`: the case below that
# proves a missing `gh` fails open builds a `PATH` carrying neither, and a
# handoff that needed them would fail closed on that `PATH` instead.
case $0 in
    */*) hook_dir=${0%/*} ;;
    *) hook_dir=. ;;
esac
hook_name=${0##*/}
self=$(cd "$hook_dir" 2>/dev/null && pwd -P)
own_dir=$(cd "$root/.githooks" 2>/dev/null && pwd -P)
if [ -z "${HEADWATER_HOOK_HANDOFF:-}" ] && [ "$self" != "$own_dir" ]; then
    own="$root/.githooks/$hook_name"
    if [ -x "$own" ]; then
        HEADWATER_HOOK_HANDOFF=1 exec "$own" "$@"
    fi
    echo "headwater: this worktree carries no $hook_name of its own, so the" >&2
    echo "  checkout core.hooksPath names ran its copy instead." >&2
fi

# Run by hand with no push behind it: there is no ref batch to read and a
# `read` against the terminal would hang the hook rather than check anything.
[ -t 0 ] && exit 0

refs=$(cat)

head_sha=$(git -C "$root" rev-parse HEAD 2>/dev/null)
pushes_head=
if [ -n "$head_sha" ]; then
	printf '%s\n' "$refs" | awk -v h="$head_sha" '$2 == h { found = 1 } END { exit !found }' && pushes_head=1
fi

if [ -n "$pushes_head" ] && [ -z "${HEADWATER_SKIP_PUSH_GATE:-}" ] && [ -f "$root/engine/Cargo.toml" ]; then
	# Format. `cargo fmt` resolves nothing and compiles nothing, so it takes
	# about a second. `--all` is what lets a virtual workspace root answer.
	if command -v cargo >/dev/null 2>&1 && cargo fmt --version >/dev/null 2>&1; then
		if ! fmt=$(cd "$root/engine" && cargo fmt --all -- --check 2>&1); then
			echo "headwater: cargo fmt would change this tree, and the Format step of CI would fail:" >&2
			printf '%s\n' "$fmt" | head -20 | sed 's/^/    /' >&2
			echo "  Fix it and amend or add a commit:" >&2
			echo "        (cd engine && cargo fmt --all)" >&2
			echo "  Or skip both push checks for one push: HEADWATER_SKIP_PUSH_GATE=1 git push ..." >&2
			exit 1
		fi
	else
		echo "headwater: no cargo fmt here, so this push is not checked for format." >&2
	fi

	# Projection. The newer of the two profiles answers, as the commit gate
	# reads them, and a binary older than the engine source is not trusted.
	release="$root/engine/target/release/headwater"
	dev_release="$root/engine/target/dev-release/headwater"
	engine=
	[ -x "$release" ] && engine=$release
	if [ -x "$dev_release" ] && { [ -z "$engine" ] || [ "$dev_release" -nt "$engine" ]; }; then
		engine=$dev_release
	fi
	if [ -z "$engine" ]; then
		echo "headwater: no built engine, so this push is not checked for stale projections." >&2
	elif [ -n "$(find "$root/engine/crates" "$root/engine/Cargo.lock" -newer "$engine" \( -name '*.rs' -o -name Cargo.lock \) -print -quit 2>/dev/null)" ]; then
		echo "headwater: the built engine is older than its source, so this push is not checked for stale projections." >&2
	elif ! gen=$(cd "$root" && "$engine" generate --check 2>&1); then
		echo "headwater: a projection of this corpus is stale, and the Every-projection step of CI would fail:" >&2
		printf '%s\n' "$gen" | head -20 | sed 's/^/    /' >&2
		echo "  Regenerate, read the diff and commit it:" >&2
		echo "        $engine generate" >&2
		echo "  Or skip both push checks for one push: HEADWATER_SKIP_PUSH_GATE=1 git push ..." >&2
		exit 1
	fi
fi

# Everything below is the warning, and it exits 0 by every path.

command -v gh >/dev/null 2>&1 || exit 0

zeroes=0000000000000000000000000000000000000000

# `--not --remotes` is the range for a branch the remote has never seen. It
# is also the only range that is safe once the remote tip is not this push's
# whole history: `$remote_sha..$local_sha` is a two-dot diff, and a two-dot
# diff excludes only the ancestors of `$remote_sha` — it does not care by
# which parent a commit is reachable from `$local_sha`. A rebase carries the
# commits the upstream gained in the meantime underneath the local tip, so
# `$remote_sha` (the pre-rebase tip) is no longer even an ancestor and the
# two-dot range reads them as though this push wrote them. A local `git merge`
# of the upstream into the branch is worse to detect: `$remote_sha` (the
# pre-merge tip) *is* still an ancestor, as the merge commit's first parent,
# so a check that only asks "is the remote tip an ancestor" takes the same
# two-dot range and reads the merged-in commits the same wrong way. Neither
# shape is rare or unsupported — this repository's own hooks treat a local
# merge of `main` as ordinary traffic — so the range never trusts an ancestry
# check to tell the two apart. It excludes every commit reachable from any
# remote-tracking ref instead, which is correct whether this push is a first
# push, a fast-forward, a rebase or a merge, because none of those change
# what `refs/remotes/origin/*` already holds before this push updates it. A
# push carrying hundreds of commits is a rebase or a first push of a long
# branch, and reading all of it to warn about a board is not worth the wait,
# so `--max-count` still caps the walk below.
numbers=$(
	printf '%s\n' "$refs" | while read -r _local_ref local_sha _remote_ref _remote_sha; do
		[ -n "$local_sha" ] || continue
		[ "$local_sha" = "$zeroes" ] && continue

		git log --format=%B --max-count=50 "$local_sha" --not --remotes 2>/dev/null
	done | grep -oE '#[0-9]+' | tr -d '#' | sort -un
)

[ -n "$numbers" ] || exit 0

# A pull request and an issue share one number space, and `gh issue view` answers
# for both — the `(#923)` a squash merge appends to a subject resolves as an
# issue with no assignee, which is the exact shape of the thing being warned
# about. The url is the discriminator and it costs no second call: a pull
# request's ends `/pull/<n>` where an issue's ends `/issues/<n>`. Measured
# against #923 and #819 on this repository.
unclaimed=
for number in $numbers; do
	answer=$(timeout 5 gh issue view "$number" --json assignees,url --jq '"\(.url) \(.assignees | length)"' 2>/dev/null) || continue
	url=${answer% *}
	count=${answer##* }
	case "$url" in
	*/pull/*) continue ;;
	*/issues/*) ;;
	*) continue ;;
	esac
	case "$count" in
	'' | *[!0-9]*) continue ;;
	esac
	[ "$count" -eq 0 ] || continue
	unclaimed="$unclaimed $number"
done

[ -n "$unclaimed" ] || exit 0

for number in $unclaimed; do
	echo "  #$number is unassigned. Claim it: gh issue edit $number --add-assignee @me" >&2
done

exit 0

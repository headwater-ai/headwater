{
  // Deployment config for https://headwater.tools/, which is the target that
  // the https://w3id.org/headwater/ permanent identifier redirects to.
  //
  // There is no Worker script. The project serves static files and nothing
  // else, so there is no "main" entry point. Cloudflare runs
  // `npx wrangler deploy` from the repository root on each push.
  //
  // THIS STILL SERVES THE HAND-BUILT HALF ALONE, AND HW-DR-0047 SAYS WHAT
  // REPLACES IT.
  //
  // That record rules that both halves are served out of one directory,
  // `.headwater/site-deploy`, which `tools/assemble-site.sh` composes from
  // the pages under `site/` and the pages `mkdocs build` renders from the
  // corpus. The directory is not committed, so nothing writes it unless the
  // deploy runs the assembly first.
  //
  // Two acts make that switch, and the order is not free. Reversing it
  // serves a directory that is not there.
  //
  //   1. In the Cloudflare dashboard, set the Workers Builds build command:
  //
  //          python3 -m pip install --break-system-packages mkdocs==1.6.1 \
  //            && python3 -m mkdocs build --strict \
  //            && sh tools/assemble-site.sh
  //
  //      This is free while the line below still reads `./site`. A build
  //      command that fails leaves the previous deploy live, so it is also
  //      the cheapest test of whether that image carries `python3` and
  //      `pip`, which is the one risk here this repository cannot retire.
  //
  //   2. Then, and only after a green build, change the line below to
  //      `./.headwater/site-deploy`.
  "name": "headwater",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./site"
  }
}

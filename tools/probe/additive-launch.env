# SPDX-License-Identifier: Apache-2.0
#
# The launch constants of a try of the additive campaign's tuning round
# (#1821). `tools/probe/try.sh` sources this file, and every try launches with
# these values, so a launch script typed by hand for each try no longer holds
# them. They are the values of try 1 of the documents layer (#1777), which
# match the screening round of 2026-10-18 (#1775). A change to one of them is
# a change to what a try measures, so make it in a commit that says why.
#
# The facts of the host are not here: `<root>/env` holds them, as
# `tools/probe/try.sh` states.

# The model of every session.
TRY_MODEL=claude-sonnet-5
# The version of the `claude` harness, pinned under `<try>/bin`.
TRY_HARNESS=2.1.288
# The most one session may spend, in cents (`--session-cents`).
TRY_SESSION_CENTS=300
# The parallel count of batch A (`--parallel`). The canary runs at 1.
TRY_PARALLEL=4
# The overshoot margin of one session past its budget, in cents
# (`--overshoot-cents`). The canary's bound is TRY_SESSION_CENTS plus this.
TRY_OVERSHOOT_CENTS=100
# The seed of the shuffled job order.
TRY_SEED=0
# The disk floors of `try.sh wait`, in KiB: free space under `/`, and on the
# file system that holds the round root. Below either, `wait` writes
# `<try>/stop`. `<root>/env` may set either for its host.
TRY_FLOOR_ROOT_KB=5242880
TRY_FLOOR_TRY_KB=15728640
# The usage gate of the driver (#1876). The owner ruled on epic #1868
# (2026-10-29): "A run stops launching sessions at 85 percent of the 7-day
# window unless the reset is under 24 hours away, in which case it runs on to
# 100 percent." `try.sh` hands these to `campaign-drive.sh` as
# `HEADWATER_DRIVE_USAGE_STOP`, `HEADWATER_DRIVE_USAGE_LATE` and
# `HEADWATER_DRIVE_USAGE_LATE_HOURS`, and the driver holds no default.
TRY_USAGE_STOP_PERCENT=85
TRY_USAGE_LATE_PERCENT=100
TRY_USAGE_LATE_HOURS=24
# The saturation stop of phase B (#1875). HW-DR-0112, "Phase B: the report":
# "A cell that saturates stops at 24 sessions. A cell saturates when all its
# sessions pass or all fail at 24." It is here and not under `rounds.final`
# of `.headwater/probe.yml`, by the adjudication of slice 3 of #1875, which
# cites the parent's slice-1 ruling. Phase B hands it to `campaign-drive.sh` as
# `--saturate-at`, and the driver holds no default. Phase B runs from #1881,
# and no verb of `try.sh` passes it yet.
TRY_SATURATE_AT=24

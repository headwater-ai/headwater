# The arguments of the `r8-utilize` oracle, one to a line, for the probe
# HW-PROBE-a-session-retires-a-word-with-its-replacement-so-that-the-check-offers-the-substitution
# (#1874). `tools/probe/oracles/lib.sh` reads this file for `--args` and
# skips each line that opens with `#`. The file names its probe, so the seal
# removes it from every workspace, and the oracle entry holds it. The
# command is `sh tools/probe/oracles/lock-regenerated.sh --check-clean --args <this file>`.
.headwater/overlay.yml
term: utilize
.headwater/overlay.yml
replacement: use

taxonomy: headwater/standard
version: 1.0.0
purposes:
  rationale:
    intent: "explain why a choice was made and what it forecloses"
    answers:
      - "why is it this way"
      - "what was rejected"
      - "what does this constrain"
  behavior:
    intent: "state what the system does, as it is now"
    answers:
      - "what does this component do"
      - "what may I rely on"
  evidence:
    answers:
      - "what closed this question"
      - "what did the review find"
      - "what evidence stands behind this claim"
    intent: "state what was measured or found, and under which instrument"
  obligation:
    answers:
      - "what is missing"
      - "which claim is unmeasured"
      - "what waits on whom"
    intent: "state what the corpus still owes, and who owes it"
vocabularies:
  lifecycle_state:
    - value: draft
      role: initial
    - value: current
      role: live
    - value: superseded
      role: terminal-retained
    - value: deprecated
      role: terminal-retained
facets:
  status:
    role: state
    values:
      - value: draft
        role: initial
      - value: current
        role: live
      - value: superseded
        role: terminal-retained
      - value: deprecated
        role: terminal-retained
    required: true
    volatility: mutable
    guidance:
      draft: "the document is being written or argued over, and nothing may rely on it"
      current: "the document states what holds now, and a reader may rely on it"
      superseded: "a later document replaced this one, and the succession edge names it"
      deprecated: "the document is no longer to be relied on, and nothing replaced it"
  status_since:
    role: state_entered
    type: date
    required: true
    volatility: mutable
  last_verified:
    role: freshness
    type: date
    stale_after_days: 180
    volatility: mutable
  summary:
    role: scent
    type: string
    required: true
    volatility: mutable
  doc_type:
    guidance:
      decision_register: "the one document that records settled decisions and the argument that settled each"
      design_spec: "a numbered document in the series, which states what the system is"
      obligation_register: "the one document that records what the corpus still owes"
      review_prompt: "the instrument that commissions a review, committed before the review runs"
      review_record: "the findings that one application of one instrument produced"
    required: false
    values:
      - design_spec
      - decision_register
      - obligation_register
      - review_prompt
      - review_record
    volatility: stable
  sequence:
    required: false
    type: integer
    volatility: stable
regimes:
  lifecycle:
    standard:
      initial: draft
      transitions:
        draft:
          - current
          - deprecated
        current:
          - superseded
          - deprecated
      retain_terminal: true
  voice:
    declarative:
      forbid:
        - future_intent
        - change_narration
        - phased_rollout
    narrative: {}
  language:
    default:
      tag: en-US
      controlled: none
    ste_house:
      controlled: ASD-STE100
      profile: house
      tag: en-US
anchors:
  code_path:
    resolver: source-tree
kinds:
  governed_document:
    abstract: true
    facets:
      require:
        - status
        - status_since
        - last_verified
        - summary
  decision:
    is_a: governed_document
    purpose: rationale
    identifier:
      scheme: decision_id
    voice: declarative
    lifecycle: standard
    sections:
      require:
        - Context
        - Decision
        - Consequences
  specification:
    is_a: governed_document
    purpose: behavior
    voice: declarative
    lifecycle: standard
    sections:
      require:
        - Scope
        - Behavior
  decision_register:
    facets:
      require:
        - doc_type
        - sequence
    identifier:
      scheme: register_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: rationale
    voice: declarative
  design_spec:
    facets:
      require:
        - doc_type
        - sequence
    identifier:
      scheme: spec_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: behavior
    voice: declarative
  evaluation:
    facets:
      forbid:
        - doc_type
    identifier:
      scheme: evaluation_id
    is_a: governed_document
    lifecycle: standard
    purpose: evidence
    relations:
      expect:
        - id: evidence-cited
          relation: cited_by
          to_kind: decision_register
          when:
            status: current
          within: 30d
          since: state_entered
          severity: warn
          rationale: "an evaluation that no register cites closed nothing"
    voice: narrative
  obligation_register:
    facets:
      require:
        - doc_type
        - sequence
    identifier:
      scheme: register_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: obligation
    voice: declarative
  review_prompt:
    facets:
      require:
        - doc_type
    identifier:
      scheme: review_id
    is_a: governed_document
    lifecycle: standard
    purpose: evidence
    relations:
      expect:
        - id: instrument-applied
          relation: applied_in
          to_kind: review_record
          when:
            status: current
          within: 90d
          since: state_entered
          severity: warn
          rationale: "an instrument that nobody applied is a plan rather than a review"
    voice: declarative
  review_record:
    facets:
      require:
        - doc_type
    identifier:
      scheme: review_id
    is_a: governed_document
    lifecycle: standard
    purpose: evidence
    voice: narrative
relations:
  supersedes:
    family: succession
    from:
      - governed_document
    to:
      - governed_document
    inverse: superseded_by
    reciprocal: required
    nuclearity: multinuclear
    on_target:
      set_state: superseded
    created_by: scaffold
  governs:
    family: governance
    from:
      - governed_document
    to:
      - code_path
    cardinality: many
    created_by: hook
  constrains:
    family: governance
    from:
      - decision
    to:
      - decision
    created_by: agent
  conflicts_with:
    family: association
    from:
      - decision
    to:
      - decision
    reciprocal: symmetric
    nuclearity: multinuclear
    invalid_when:
      both:
        status: current
    created_by: agent
  traces_to:
    family: evidence
    from:
      - governed_document
    to:
      - governed_document
      - code_path
    created_by: hook
  applied_in:
    created_by: scaffold
    family: evidence
    from:
      - review_prompt
    inverse: applies
    reciprocal: required
    to:
      - review_record
  assesses:
    cardinality: many
    created_by: scaffold
    family: evidence
    from:
      - review_record
    to:
      - governed_document
  cites_evidence:
    cardinality: many
    created_by: hook
    family: evidence
    from:
      - design_spec
      - decision_register
      - obligation_register
    inverse: cited_by
    reciprocal: required
    to:
      - evaluation
shelves:
  decisions:
    path: "docs/decisions/**"
    homogeneous: true
    kind: decision
  specifications:
    path: "docs/specifications/**"
    homogeneous: true
    kind: specification
  evaluations:
    homogeneous: true
    kind: evaluation
    path: "docs/evaluations/**"
  reviews:
    discriminator: doc_type
    homogeneous: false
    kinds:
      - review_prompt
      - review_record
    path: "docs/reviews/**"
  spec_series:
    discriminator: doc_type
    homogeneous: false
    kinds:
      - design_spec
      - decision_register
      - obligation_register
    layout: "{sequence:02d}-{slug}.md"
    path: "docs/spec/**"
identifier_schemes:
  decision_id:
    pattern: "DR-{namespace}-{seq:04d}"
    namespace: repo
    allocation: reconcile-first
  evaluation_id:
    allocation: minted-once
    namespace: HW
    pattern: "EVAL-{namespace}-{slug}"
  register_id:
    allocation: minted-once
    namespace: HW
    pattern: "REG-{namespace}-{slug}"
  review_id:
    allocation: minted-once
    namespace: HW
    pattern: "REV-{namespace}-{slug}"
  spec_id:
    allocation: minted-once
    namespace: HW
    pattern: "SPEC-{namespace}-{slug}"
core:
  requires:
    - facet_role: state
    - facet_role: freshness
    - facet_role: scent
    - purpose: rationale
    - purpose: behavior
    - relation_family: succession
      lifecycle_sensitive: true
projections:
  - kind: shelf_index
    for:
      - decisions
      - specifications
    output: "{shelf}/README.md"
obligations:
  OB-COV-1:
    statement: "Every file under the corpus root is classified, or reported as unclassifiable"
    rationale: "The most broken document is the one that classification is most likely to miss, and a run that never saw it reports nothing about it"
    class: cohesion
    prevents: process.maintenance
    severity: high
  OB-COV-2:
    statement: "Every classified document is routed to at least one check"
    rationale: "A document that matched no check is indistinguishable from a document that passed every check"
    class: cohesion
    prevents: process.maintenance
    severity: high
  OB-COV-3:
    statement: "Every run reports what it saw, classified, checked and skipped, with a reason for each skip"
    rationale: "No findings across 380 of 412 documents is a different result from no findings across 412, and a report that cannot tell the two apart earns no trust"
    class: cohesion
    prevents: process.traceability
    severity: medium
  OB-REL-1:
    statement: "A relation that requires reciprocity is declared at both of its ends"
    rationale: "One half of a pair is a claim that the document at the other end never made"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-PLACE-1:
    statement: "A document does not restate in metadata what its placement already states"
    rationale: "A restatement is a second truth that eventually disagrees with the first"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-FACET-1:
    statement: "Every facet a kind requires is declared by every document of that kind"
    rationale: "A facet nobody declared is a question the corpus cannot answer about itself, and the reader who asks it gets silence rather than a gap"
    class: cohesion
    prevents: content.incomplete
    severity: high
  OB-FACET-2:
    statement: "A facet with a declared value set carries one of the values in that set"
    rationale: "A value outside the set is a state that no reader, no query and no projection can act on, and it reads as a state rather than as an error"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-REL-2:
    statement: "Both ends of a relation instance are kinds that the relation permits"
    rationale: "An edge between kinds a relation forbids is an assertion that the taxonomy never sanctioned, and every query over that relation inherits it"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-REL-3:
    statement: "A participation expectation is met inside the window the taxonomy declares"
    rationale: "A document that nothing links to inside its window is work that reached nobody, and the corpus cannot tell that from work nobody needed"
    class: cohesion
    prevents: process.maintenance
    severity: low
controls:
  CT-COV-2:
    mechanism: "check:coverage.document_unchecked"
    discharges:
      - OB-COV-2
    trigger: pull_request
    posture: advisory
  CT-REL-1:
    mechanism: "check:relation.reciprocity.missing"
    discharges:
      - OB-REL-1
    trigger: pull_request
    posture: advisory
  CT-PLACE-1:
    mechanism: "check:shelf.placement_is_primary"
    discharges:
      - OB-PLACE-1
    trigger: pull_request
    posture: advisory
  CT-FACET-1:
    mechanism: "check:facet.required.missing"
    discharges:
      - OB-FACET-1
    trigger: pull_request
    posture: advisory
  CT-FACET-2:
    mechanism: "check:facet.value.not_permitted"
    discharges:
      - OB-FACET-2
    trigger: pull_request
    posture: advisory
  CT-REL-2:
    mechanism: "check:relation.endpoint.not_permitted"
    discharges:
      - OB-REL-2
    trigger: pull_request
    posture: advisory
  CT-REL-3:
    mechanism: "check:relation.participation.overdue"
    discharges:
      - OB-REL-3
    trigger: pull_request
    posture: advisory

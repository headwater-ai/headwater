taxonomy: headwater/standard
version: 3.3.0
purposes:
  rationale:
    intent: "explain why a choice was made and what it forecloses"
    answers:
      - "why is it this way"
      - "what was rejected"
      - "what does this constrain"
  behavior:
    intent: "state what the system does, as it is now"
    answers:
      - "what does this component do"
      - "what may I rely on"
  evidence:
    answers:
      - "what closed this question"
      - "what did the review find"
      - "what evidence stands behind this claim"
    intent: "state what was measured or found, and under which instrument"
  obligation:
    answers:
      - "what is missing"
      - "which claim is unmeasured"
      - "what waits on whom"
    intent: "state what the corpus still owes, and who owes it"
  procedure:
    answers:
      - "how do I start"
      - "how do I set this up"
      - "what are the steps"
    intent: "state the steps a reader follows, and the state each step reaches"
  requirement:
    answers:
      - "what must this do"
      - "what does done mean here"
      - "what would show that this is met"
    intent: "state what must hold before a thing is built, and what decides that it holds"
vocabularies:
  lifecycle_state:
    - value: draft
      role: initial
    - value: current
      role: live
    - value: superseded
      role: terminal-retained
    - value: deprecated
      role: terminal-retained
    - value: discharged
      role: terminal-retained
facets:
  status:
    role: state
    values:
      - value: draft
        role: initial
      - value: current
        role: live
      - value: superseded
        role: terminal-retained
      - value: deprecated
        role: terminal-retained
      - value: discharged
        role: terminal-retained
    required: true
    volatility: mutable
    guidance:
      draft: "the document is being written or argued over, and nothing may rely on it"
      current: "the document states what holds now, and a reader may rely on it"
      superseded: "a later document replaced this one, and the succession edge names it"
      deprecated: "the document is no longer to be relied on, and nothing replaced it"
      discharged: "the document recorded something the corpus owed, the corpus paid it, and the record is kept as the receipt"
  status_since:
    role: state_entered
    type: date
    required: true
    volatility: mutable
  last_verified:
    role: freshness
    type: date
    stale_after_days: 180
    volatility: mutable
  summary:
    role: scent
    type: string
    required: true
    volatility: mutable
  arm:
    guidance:
      absent: "the session ran against the declared ablation of it"
      present: "the session ran against the corpus"
    required: false
    values:
      - present
      - absent
    volatility: stable
  doc_type:
    guidance:
      decision_register: "the one document that records settled decisions and the argument that settled each"
      design_spec: "a numbered document in the series, which states what the system is"
      obligation_register: "the one document that records what the corpus still owes"
      review_prompt: "the instrument that commissions a review, committed before the review runs"
      review_record: "the findings that one application of one instrument produced"
    required: false
    values:
      - design_spec
      - decision_register
      - obligation_register
      - review_prompt
      - review_record
    volatility: stable
  expectation:
    guidance:
      answered: "the final answer is one named value from the closed set this probe declares"
      cited: "a produced artifact cites one of the identifiers this probe names"
      not_opened: "the transcript shows that the session read none of them"
      opened: "the transcript shows that the session read one of the documents this probe names"
      patched: "a produced patch passes the check this probe names"
    required: false
    values:
      - opened
      - not_opened
      - cited
      - answered
      - patched
    volatility: stable
  oracle:
    required: false
    type: string
    volatility: stable
  probe_category:
    guidance:
      consistency: "the probe asks whether two phrasings of one question reach one answer"
      discovery: "the probe asks whether the agent finds the governing document at all"
      navigability: "the probe asks whether the agent gets from a code path to the governing document and back"
      sufficiency: "the probe asks whether the agent has enough to act correctly once it has found the document"
    required: false
    values:
      - discovery
      - sufficiency
      - navigability
      - consistency
    volatility: stable
  sequence:
    required: false
    type: integer
    volatility: stable
  tier:
    guidance:
      campaign: "both arms, powered, one batch and one model version, for one named claim"
      regression: "a fixed scenario set in one arm against a recorded baseline, which establishes no effect"
    required: false
    values:
      - regression
      - campaign
    volatility: stable
  title:
    required: false
    role: name
    type: string
    volatility: stable
  verification_method:
    guidance:
      analysis: "reason from a model, a calculation or a result already established, where a run is not possible and not needed"
      demonstration: "operate the system and observe the behavior the fit criterion states, with no instrument beyond the observation"
      inspection: "read the artifact against the fit criterion, and run nothing"
      test: "run the system and compare a measured result against the fit criterion"
    required: false
    type: string
    values:
      - test
      - demonstration
      - inspection
      - analysis
    volatility: mutable
  waiting_on:
    guidance:
      adopter: "an outside corpus has to exist before anything can move"
      build: "the answer is known and somebody has to write the code or the prose"
      measurement: "an instrument exists and no run of it has been made"
      ruling: "a person has to choose, and no build and no measurement settles it"
    required: false
    type: string
    values:
      - ruling
      - build
      - measurement
      - adopter
    volatility: mutable
regimes:
  lifecycle:
    standard:
      initial: draft
      transitions:
        draft:
          - current
          - deprecated
        current:
          - superseded
          - deprecated
      retain_terminal: true
    obligation:
      initial: draft
      transitions:
        draft:
          - current
          - deprecated
        current:
          - superseded
          - deprecated
          - discharged
      retain_terminal: true
  voice:
    declarative:
      forbid:
        - future_intent
        - change_narration
        - phased_rollout
    narrative: {}
    prospective:
      forbid:
        - change_narration
        - phased_rollout
  language:
    default:
      tag: en-US
      controlled: none
    ste_house:
      controlled: ASD-STE100
      profile: house
      retired_terms:
        - term: load-bearing
          reason: "it stands in for the thing that depends on it"
        - term: "load bearing"
          reason: "it stands in for the thing that depends on it"
        - term: first-class
          reason: "it stands in for what the thing actually gets"
        - term: "first class"
          reason: "it stands in for what the thing actually gets"
        - term: battle-tested
          reason: "it stands in for where the thing has run and for how long"
        - term: "battle tested"
          reason: "it stands in for where the thing has run and for how long"
        - term: "north star"
          reason: "it stands in for the goal"
        - term: delve
          reason: "it stands in for examine, study or read"
        - term: seamless
          reason: "it stands in for what the joins would otherwise cost"
        - term: seamlessly
          reason: "it stands in for what the joins would otherwise cost"
        - term: holistic
          reason: "it stands in for the parts it covers"
        - term: holistically
          reason: "it stands in for the parts it covers"
        - term: "deep dive"
          reason: "it stands in for a detailed review"
        - term: leverage
          reason: "it stands in for use or apply"
        - term: leverages
          reason: "it stands in for use or apply"
        - term: leveraged
          reason: "it stands in for use or apply"
        - term: leveraging
          reason: "it stands in for use or apply"
        - term: robust
          reason: "it stands in for the failure the thing survives"
      source_form: one_line_per_block
      tag: en-US
anchors:
  code_path:
    resolver: source-tree
kinds:
  governed_document:
    abstract: true
    facets:
      require:
        - status
        - status_since
        - last_verified
        - summary
  decision:
    is_a: governed_document
    purpose: rationale
    identifier:
      scheme: decision_id
    voice: declarative
    lifecycle: standard
    sections:
      require:
        - Context
        - Decision
        - Consequences
    facets:
      require:
        - title
    language: ste_house
  specification:
    is_a: governed_document
    purpose: behavior
    voice: declarative
    lifecycle: standard
    sections:
      require:
        - Scope
        - Behavior
  acceptance_criterion:
    facets:
      require:
        - title
        - verification_method
    identifier:
      scheme: acceptance_criterion_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: requirement
    sections:
      require:
        - "Fit criterion"
        - Method
    voice: prospective
  decision_register:
    facets:
      require:
        - doc_type
        - sequence
    identifier:
      scheme: register_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: rationale
    voice: declarative
  design_spec:
    facets:
      require:
        - doc_type
        - sequence
    identifier:
      scheme: spec_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: behavior
    voice: declarative
  evaluation:
    facets:
      forbid:
        - doc_type
    identifier:
      scheme: evaluation_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: evidence
    relations:
      expect:
        - id: evidence-cited
          relation: cited_by
          to_kind: decision_register
          when:
            status: current
          within: 30d
          since: state_entered
          severity: warn
          rationale: "an evaluation that no register cites closed nothing"
    voice: narrative
  interface_contract:
    facets:
      require:
        - title
    identifier:
      scheme: interface_contract_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: behavior
    sections:
      require:
        - Synopsis
        - Description
        - Preconditions
        - Options
        - "Exit status"
        - Environment
        - Files
        - "See also"
    voice: declarative
  obligation_record:
    facets:
      require:
        - title
        - waiting_on
    identifier:
      scheme: obligation_record_id
    is_a: governed_document
    language: ste_house
    lifecycle: obligation
    purpose: obligation
    sections:
      require:
        - Context
        - Obligation
        - Discharge
    voice: declarative
  obligation_register:
    facets:
      require:
        - doc_type
        - sequence
    identifier:
      scheme: register_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: obligation
    voice: declarative
  probe:
    facets:
      require:
        - probe_category
        - expectation
        - oracle
    identifier:
      scheme: probe_id
    is_a: governed_document
    lifecycle: standard
    purpose: evidence
    sections:
      require:
        - Task
        - Expectation
    voice: declarative
  probe_result:
    identifier:
      scheme: result_id
    is_a: governed_document
    lifecycle: standard
    purpose: evidence
    voice: declarative
  probe_transcript:
    facets:
      require:
        - tier
        - arm
    identifier:
      scheme: run_id
    is_a: governed_document
    lifecycle: standard
    purpose: evidence
    sections:
      require:
        - "Run identity"
        - Events
    voice: narrative
  requirement:
    facets:
      require:
        - title
    identifier:
      scheme: requirement_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: requirement
    relations:
      expect:
        - id: requirement-verified
          relation: verified_by
          to_kind: acceptance_criterion
          when:
            status: current
          within: 90d
          since: state_entered
          severity: warn
          rationale: "a requirement that nothing verifies is a claim nobody can settle"
    sections:
      require:
        - Context
        - Requirement
        - Verification
    voice: prospective
  review_prompt:
    facets:
      require:
        - doc_type
    identifier:
      scheme: review_id
    is_a: governed_document
    lifecycle: standard
    purpose: evidence
    relations:
      expect:
        - id: instrument-applied
          relation: applied_in
          to_kind: review_record
          when:
            status: current
          within: 90d
          since: state_entered
          severity: warn
          rationale: "an instrument that nobody applied is a plan rather than a review"
    voice: declarative
  review_record:
    facets:
      require:
        - doc_type
    identifier:
      scheme: review_id
    is_a: governed_document
    lifecycle: standard
    purpose: evidence
    voice: narrative
  tutorial:
    facets:
      require:
        - title
    identifier:
      scheme: tutorial_id
    is_a: governed_document
    language: ste_house
    lifecycle: standard
    purpose: procedure
    sections:
      require:
        - "Before you start"
        - Steps
        - "The words this teaches"
        - "Where to go next"
    voice: declarative
relations:
  supersedes:
    family: succession
    from:
      - governed_document
    to:
      - governed_document
    inverse: superseded_by
    reciprocal: required
    nuclearity: multinuclear
    on_target:
      set_state: superseded
    created_by: scaffold
  governs:
    family: governance
    from:
      - governed_document
    to:
      - code_path
    cardinality: many
    created_by: hook
  constrains:
    family: governance
    from:
      - decision
    to:
      - decision
    created_by: agent
  conflicts_with:
    family: association
    from:
      - decision
    to:
      - decision
    reciprocal: symmetric
    nuclearity: multinuclear
    invalid_when:
      both:
        status: current
    created_by: agent
  traces_to:
    family: evidence
    from:
      - governed_document
    to:
      - governed_document
      - code_path
    created_by: hook
  applied_in:
    created_by: scaffold
    family: evidence
    from:
      - review_prompt
    inverse: applies
    reciprocal: required
    to:
      - review_record
  assesses:
    cardinality: many
    created_by: scaffold
    family: evidence
    from:
      - review_record
    to:
      - governed_document
  cites_evidence:
    cardinality: many
    created_by: hook
    family: evidence
    from:
      - design_spec
      - decision_register
      - obligation_register
    inverse: cited_by
    reciprocal: required
    to:
      - evaluation
  discharges:
    cardinality: many
    created_by: hook
    family: evidence
    from:
      - evaluation
    inverse: discharged_by
    reciprocal: required
    to:
      - obligation_record
  examines:
    cardinality: many
    created_by: author
    family: evidence
    from:
      - probe
    to:
      - governed_document
      - code_path
  records:
    cardinality: many
    created_by: generator
    family: evidence
    from:
      - probe_transcript
    to:
      - probe
  verified_by:
    cardinality: many
    created_by: scaffold
    family: evidence
    from:
      - requirement
    inverse: verifies
    reciprocal: required
    to:
      - acceptance_criterion
      - probe
shelves:
  decisions:
    path: "docs/decisions/**"
    homogeneous: true
    kind: decision
    layout: "{seq:04d}-{slug}.md"
  specifications:
    path: "docs/specifications/**"
    homogeneous: true
    kind: specification
  acceptance_criteria:
    homogeneous: true
    kind: acceptance_criterion
    layout: "{seq:04d}-{slug}.md"
    path: "docs/acceptance-criteria/**"
  evaluations:
    homogeneous: true
    kind: evaluation
    path: "docs/evaluations/**"
  interfaces:
    homogeneous: true
    kind: interface_contract
    path: "docs/interfaces/**"
  obligations:
    homogeneous: true
    kind: obligation_record
    layout: "{seq:04d}-{slug}.md"
    path: "docs/obligations/**"
  probe_results:
    homogeneous: true
    kind: probe_result
    path: "docs/probe-results/**"
  probe_runs:
    homogeneous: true
    kind: probe_transcript
    path: "docs/probe-runs/**"
  probes:
    homogeneous: true
    kind: probe
    path: "docs/probes/**"
  requirements:
    homogeneous: true
    kind: requirement
    layout: "{seq:04d}-{slug}.md"
    path: "docs/requirements/**"
  reviews:
    discriminator: doc_type
    homogeneous: false
    kinds:
      - review_prompt
      - review_record
    path: "docs/reviews/**"
  spec_series:
    discriminator: doc_type
    homogeneous: false
    kinds:
      - design_spec
      - decision_register
      - obligation_register
    layout: "{sequence:02d}-{slug}.md"
    path: "docs/spec/**"
  tutorials:
    homogeneous: true
    kind: tutorial
    path: "docs/tutorials/**"
identifier_schemes:
  decision_id:
    pattern: "{namespace}-DR-{seq:04d}"
    allocation: reconcile-first
    namespace: HW
  acceptance_criterion_id:
    allocation: reconcile-first
    namespace: HW
    pattern: "{namespace}-AC-{seq:04d}"
  evaluation_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-EVAL-{slug}"
  interface_contract_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-IFACE-{slug}"
  obligation_record_id:
    allocation: reconcile-first
    namespace: HW
    pattern: "{namespace}-OBL-{seq:04d}"
  probe_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-PROBE-{slug}"
  register_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-REG-{slug}"
  requirement_id:
    allocation: reconcile-first
    namespace: HW
    pattern: "{namespace}-REQ-{seq:04d}"
  result_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-RESULT-{slug}"
  review_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-REV-{slug}"
  run_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-RUN-{slug}"
  spec_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-SPEC-{slug}"
  tutorial_id:
    allocation: minted-once
    namespace: HW
    pattern: "{namespace}-TUT-{slug}"
core:
  requires:
    - facet_role: state
    - facet_role: freshness
    - facet_role: scent
    - purpose: rationale
    - purpose: behavior
    - relation_family: succession
      lifecycle_sensitive: true
projections:
  - kind: shelf_index
    for:
      - decisions
      - specifications
    output: "{shelf}/README.md"
  - kind: shelf_index
    for:
      - spec_series
    output: "{shelf}/README.md"
  - kind: shelf_sections
    for:
      - decisions
    output: docs/spec/09-open-questions.md
    identity:
      id: HW-REG-open-questions
      kind: decision_register
  - kind: probe_result
    output: "docs/probe-results/{run}.md"
    identity:
      id: "HW-RESULT-{run}"
      kind: probe_result
  - kind: verb_index
    for:
      - interfaces
    output: docs/interfaces/README.md
obligations:
  OB-COV-1:
    statement: "Every file under the corpus root is classified, or reported as unclassifiable"
    rationale: "The most broken document is the one that classification is most likely to miss, and a run that never saw it reports nothing about it"
    class: cohesion
    prevents: process.maintenance
    severity: high
  OB-COV-2:
    statement: "Every classified document is routed to at least one check"
    rationale: "A document that matched no check is indistinguishable from a document that passed every check"
    class: cohesion
    prevents: process.maintenance
    severity: high
  OB-COV-3:
    statement: "Every run reports what it saw, classified, checked and skipped, with a reason for each skip"
    rationale: "No findings across 380 of 412 documents is a different result from no findings across 412, and a report that cannot tell the two apart earns no trust"
    class: cohesion
    prevents: process.traceability
    severity: medium
  OB-REL-1:
    statement: "A relation that requires reciprocity is declared at both of its ends"
    rationale: "One half of a pair is a claim that the document at the other end never made"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-PLACE-1:
    statement: "A document does not restate in metadata what its placement already states"
    rationale: "A restatement is a second truth that eventually disagrees with the first"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-FACET-1:
    statement: "Every facet a kind requires is declared by every document of that kind"
    rationale: "A facet nobody declared is a question the corpus cannot answer about itself, and the reader who asks it gets silence rather than a gap"
    class: cohesion
    prevents: content.incomplete
    severity: high
  OB-FACET-2:
    statement: "A facet with a declared value set carries one of the values in that set"
    rationale: "A value outside the set is a state that no reader, no query and no projection can act on, and it reads as a state rather than as an error"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-ID-1:
    statement: "An identifier is a string that the scheme its kind names admits"
    rationale: "An identifier is minted to travel, so it appears in commit messages, tickets and agent prompts. A corpus can rewrite its own documents at any time and it can never rewrite somebody else's ticket, which is why an identifier outside its own namespace is unrecoverable rather than untidy"
    class: cohesion
    prevents: content.inconsistent
    severity: high
  OB-REL-4:
    statement: "Every target a relation instance names resolves to a document or to an external anchor"
    rationale: "An edge that resolves to nothing is a claim about a thing the corpus does not hold, and every query, projection and export over that relation inherits the claim while the report of it stops at the graph build"
    class: cohesion
    prevents: content.inconsistent
    severity: high
  OB-REL-5:
    statement: "Every entry a relations block declares becomes an edge of the graph"
    rationale: "A block the build could not read declares nothing, so the corpus is missing exactly the relations its author wrote down, and the author is the only person who ever sees the claim"
    class: cohesion
    prevents: content.inconsistent
    severity: high
  OB-REL-6:
    statement: "An edge an import wrote names its upstream item at the revision the edge was verified against"
    rationale: "An upstream item moves under an edge that nobody touched, so the corpus keeps asserting a claim that was checked against a state the far end has left. The pin says the snapshot advanced and says nothing about which document now carries a stale claim, and the author who could re-verify the edge is the one person the advance never reaches"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-ID-2:
    statement: "A document that a relation may name declares one identifier that names it"
    rationale: "A document with no identifier is neither end of any edge, so every relation it declares and every relation that names it is lost while the document itself is reported as classified and checked"
    class: cohesion
    prevents: content.incomplete
    severity: high
  OB-ID-3:
    statement: "No two documents of a corpus claim one identifier"
    rationale: "An identifier that names two documents names neither, so a target that reaches for it binds to whichever the index saw first while the other becomes unreachable, and both authors wrote a well-formed identifier that their scheme admits"
    class: cohesion
    prevents: content.inconsistent
    severity: high
  OB-REL-2:
    statement: "Both ends of a relation instance are kinds that the relation permits"
    rationale: "An edge between kinds a relation forbids is an assertion that the taxonomy never sanctioned, and every query over that relation inherits it"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-VOICE-1:
    statement: "Prose of a kind under a voice regime does not use the constructions that regime forbids"
    rationale: "A specification that narrates change cannot be read for what holds now, and a reader who cannot tell today from last quarter reads every sentence twice"
    class: cohesion
    prevents: content.inconsistent
    severity: low
  OB-LANG-1:
    statement: "Prose of a kind under a language regime obeys the controlled language and the variant it names"
    rationale: "A rule that lives in a contributing guide is a rule that no check reads and that every new author learns by being corrected"
    class: cohesion
    prevents: content.unclear
    severity: low
  OB-LANG-2:
    statement: "The source of a document under a language regime that fixes a source form is written in that form"
    rationale: "A source form is invisible to a reader and loud in a diff, so a paragraph that one commit reflows hides the one word another commit changed"
    class: cohesion
    prevents: content.unclear
    severity: low
  OB-LANG-3:
    statement: "Prose of a kind under a language regime does not write a term that regime retired"
    rationale: "A retirement that lives in a commit message is inherited by nobody, so a branch written from an earlier commit reintroduces the term and the merge is clean"
    class: cohesion
    prevents: content.inconsistent
    severity: low
  OB-SECT-1:
    statement: "Every section a kind requires is a heading of every document of that kind"
    rationale: "A document that omits a section leaves unanswered the question its kind promised to answer, and a reader cannot tell that from an answer of none"
    class: cohesion
    prevents: content.incomplete
    severity: high
  OB-LINK-1:
    statement: "A fragment that a document writes into itself names a heading of that document"
    rationale: "A link that lands nowhere costs the reader the paragraph it was written to reach, and an anchor rots silently when the heading beside it is edited"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-REL-3:
    statement: "A participation expectation is met inside the window the taxonomy declares"
    rationale: "A document that nothing links to inside its window is work that reached nobody, and the corpus cannot tell that from work nobody needed"
    class: cohesion
    prevents: process.maintenance
    severity: low
  OB-WARRANT-1:
    statement: "A warrant that moves from `asserted` to `accepted` is counted in the change that moved it"
    rationale: "A script that stamps forty documents writes bytes identical to forty real acceptances, and the standing `asserted` population cannot separate them because a bulk stamp lowers it by exactly what forty reviews would. A count per change is the only reading that can, and a promotion nobody counted is a review nobody can find"
    class: cohesion
    prevents: process.traceability
    severity: medium
  OB-LIFE-1:
    statement: "A document moves between states only along an edge the lifecycle regime of its kind declares"
    rationale: "One state value cannot say how it was reached, so a corpus run sees a document that skipped every state between where it was and where it is as one that walked there. A machine that admits every movement is a vocabulary with an arrow drawn on it, and the states that a taxonomy went to the trouble of ordering then order nothing"
    class: cohesion
    prevents: process.traceability
    severity: medium
  OB-LIFE-2:
    statement: "A document stands only at a state that the lifecycle regime of its kind names"
    rationale: "A state vocabulary is one list for a whole taxonomy, so a value that means something for one kind is spelled the same on every other. A document set to a state its kind has no use for reads to a person as a claim about that document and to every rule as nothing at all, and a movement rule cannot see it because a document authored at the wrong state made no movement"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-LIFE-3:
    statement: "A live document does not depend on a terminal one through a relation whose family this taxonomy declares lifecycle-sensitive"
    rationale: "A retired document is kept so that the record of what it said survives, not so that new work can rest on it. A live document that leans on one states a claim the corpus has withdrawn, and the reader who follows the link has no way to tell a citation of the record from a reliance on it. The relation whose declaration writes a state onto its target is exempt, because that edge is what put the target where it stands"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-LIFE-4:
    statement: "A document standing at a terminal state of a regime that declares `retain_terminal` is not deleted from the corpus"
    rationale: "A terminal state is where a document is kept rather than where it stops mattering, and `retain_terminal` is the member that says so. A corpus that deletes the record loses the only account of what it once said, and every citation of it then resolves to nothing. No standing reading of the corpus can report the loss, because a document that left leaves no row to report about, so the change that removes it is the one moment the claim is checkable"
    class: cohesion
    prevents: content.inconsistent
    severity: medium
  OB-REG-1:
    statement: "Every obligation this taxonomy declares carries exactly one disposition"
    rationale: "An obligation that no control discharges and that states neither a gap nor an acceptance reads from outside like one that is met, and that silence is how an assurance model decays into a list of good intentions"
    class: cohesion
    prevents: process.traceability
    severity: high
  OB-REG-2:
    statement: "Every control names a mechanism that the engine implements"
    rationale: "A register that claims coverage it does not have is worse than no register, and a mistyped rule id claims exactly that"
    class: cohesion
    prevents: process.traceability
    severity: high
  OB-DR-1:
    class: cohesion
    disposition:
      gap:
        owner: "the decision-record entry"
        target: "a change-scoped rule that reads the prior version, which spec 12 already supplies as `needs_prior`"
    prevents: content.inconsistent
    rationale: "A record that changed after the decision was taken cannot be cited, because the reader of the citation and the writer of it read two different texts. Every later document that names the decision inherits the drift silently"
    severity: high
    statement: "An accepted decision record is amended by succession and never by edit"
  OB-DR-2:
    class: cohesion
    disposition:
      gap:
        owner: "the decision-record entry"
        target: "a rule over state dwell time, which `taxonomy audit` already measures and no check reads"
    prevents: process.maintenance
    rationale: "A log that fills with proposals is the failure this tradition is most often reported to have, and a proposal nobody ruled on is indistinguishable from a decision nobody wrote"
    severity: medium
    statement: "A proposed decision record reaches acceptance or rejection"
  OB-DR-3:
    class: coherence
    disposition:
      unverifiable:
        reasoning: "To count the decisions in a document is to reason about what the prose asserts, which spec 1 forswears. The shelf is homogeneous and the section contract requires one `Decision` heading, and a second decision under that heading is invisible to both"
    prevents: content.unclear
    rationale: "Two decisions in one record cannot be superseded apart, so the first of them to fall takes the second with it or keeps it alive under a heading nobody reads"
    severity: medium
    statement: "A decision record records one decision"
controls:
  CT-COV-1:
    mechanism: "phase:census.classification"
    discharges:
      - OB-COV-1
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      produces_facts:
        reasoning: "The census produces the classification that every check rests on, and a wrong row makes every check over it return a correct verdict about a wrong corpus. Spec 12 holds it as a correctness root and its instrument is a fixture set"
  CT-COV-2:
    mechanism: "check:coverage.document_unchecked"
    discharges:
      - OB-COV-2
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-COV-3:
    mechanism: "phase:runner.coverage_report"
    discharges:
      - OB-COV-3
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      produces_facts:
        reasoning: "The coverage account is the denominator every other number in the report is read against, and a denominator has no false-positive rate. It is right or it is wrong, and the fixture tree is what says which"
  CT-REG-1:
    mechanism: "check:obligation.disposition.not_one"
    discharges:
      - OB-REG-1
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-REG-2:
    mechanism: "check:control.mechanism.unimplemented"
    discharges:
      - OB-REG-2
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-REL-1:
    mechanism: "check:relation.reciprocity.missing"
    discharges:
      - OB-REL-1
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-PLACE-1:
    mechanism: "check:shelf.placement_is_primary"
    discharges:
      - OB-PLACE-1
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-FACET-1:
    mechanism: "check:facet.required.missing"
    discharges:
      - OB-FACET-1
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-FACET-2:
    mechanism: "check:facet.value.not_permitted"
    discharges:
      - OB-FACET-2
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-ID-1:
    mechanism: "check:identifier.pattern.not_met"
    discharges:
      - OB-ID-1
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-REL-4:
    mechanism: "check:relation.target.unresolved"
    discharges:
      - OB-REL-4
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      criteria:
        window: "one release of the taxonomy over an adopting corpus"
        threshold: "no false positive, because the rule reports what the graph build already resolved rather than deriving a second answer of its own"
        sample: "every finding of one run over the adopting corpus, adjudicated once"
  CT-REL-5:
    mechanism: "check:relation.declaration.unusable"
    discharges:
      - OB-REL-5
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      criteria:
        window: "one release of the taxonomy over an adopting corpus"
        threshold: "no false positive, because the rule reports what the graph build already threw away rather than reading the block a second time"
        sample: "every finding of one run over the adopting corpus, adjudicated once"
  CT-REL-6:
    mechanism: "check:relation.target.suspect"
    discharges:
      - OB-REL-6
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      criteria:
        window: "one release of the taxonomy over an adopting corpus"
        threshold: "no false positive, because the rule compares two values the corpus already holds and reports nothing where either one is absent"
        sample: "every finding of one run over the adopting corpus, adjudicated once"
  CT-ID-2:
    mechanism: "check:identifier.unusable"
    discharges:
      - OB-ID-2
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      criteria:
        window: "one release of the taxonomy over an adopting corpus"
        threshold: "no false positive, because the rule reports what the identifier index already refused rather than deriving a second answer"
        sample: "every finding of one run over the adopting corpus, adjudicated once"
  CT-ID-3:
    mechanism: "check:identifier.claimed_twice"
    discharges:
      - OB-ID-3
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      criteria:
        window: "one release of the taxonomy over an adopting corpus"
        threshold: "no false positive, because the rule reports the collision the identifier index already found rather than comparing identifiers a second time"
        sample: "every finding of one run over the adopting corpus, adjudicated once"
  CT-REL-2:
    mechanism: "check:relation.endpoint.not_permitted"
    discharges:
      - OB-REL-2
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-REL-3:
    mechanism: "check:relation.participation.overdue"
    discharges:
      - OB-REL-3
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-VOICE-1:
    mechanism: "check:voice.forbidden_construction"
    discharges:
      - OB-VOICE-1
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      permanently_advisory:
        reasoning: "Spec 3 rules that posture per voice category comes from fixability and never from precision, and that a category whose remediation is a rewrite stays advisory whatever its false-positive rate. To block on it makes a judgment about meaning into a gate, and the author who meets it at a red build reaches for the escape hatch"
  CT-WARRANT-1:
    mechanism: "check:warrant.promoted"
    discharges:
      - OB-WARRANT-1
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      permanently_advisory:
        reasoning: "Spec 3 rules the posture directly. \"Forty in one change is a finding about the review rather than about the documents. The posture is advisory permanently, for the reason that the shift ratio is advisory permanently. A threshold teaches people to promote in smaller batches, and nothing declares one.\" A promotion is a legitimate act, so the rule reports a count and never a defect, and there is nothing for a gate to block on until a taxonomy states how many is too many"
  CT-LIFE-1:
    mechanism: "check:lifecycle.transition.not_permitted"
    discharges:
      - OB-LIFE-1
    trigger: pull_request
    posture: blocking
    acts: detective
    promotion:
      final_posture:
        reasoning: "The promotion path collects evidence about a rule that can be wrong about the text it reads, and this one reads two declared values and one declared edge. A movement it refuses is refused by the taxonomy that the corpus itself resolved, so an advisory period would measure a false-positive rate that the construction fixes at zero, and it would collect that reading while illegal movements landed. Spec 3 states the posture in one sentence, which is that the engine rejects a transition that is not in the declared machine when it lands"
  CT-LIFE-2:
    mechanism: "check:lifecycle.state.not_admitted"
    discharges:
      - OB-LIFE-2
    trigger: pull_request
    posture: blocking
    acts: detective
    promotion:
      final_posture:
        reasoning: "The same reading CT-LIFE-1 takes, and the input is narrower still. This rule reads one declared value against one declared state set, both of which the corpus itself resolved, so an advisory period would measure a false-positive rate that the construction fixes at zero. What it cannot decide is which admitted state the document belongs in, and that is why the finding carries no patch rather than why it should not block"
  CT-LIFE-3:
    mechanism: "check:lifecycle.dependency.on_terminal"
    discharges:
      - OB-LIFE-3
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      permanently_advisory:
        reasoning: "The two rules above it read declared values and refuse what the declaration refuses, and this one reads the same values and cannot say what to do about them. A live document resting on a retired one is repaired by pointing at the successor, by retiring the citing document, or by a judgment that the citation stands as a citation of the record. There is no fourth answer and the engine cannot pick among the three, so a posture that stopped a merge would stop it on a question only an author can settle"
  CT-LIFE-4:
    mechanism: "check:lifecycle.deletion.not_permitted"
    discharges:
      - OB-LIFE-4
    trigger: pull_request
    posture: blocking
    acts: detective
    promotion:
      final_posture:
        reasoning: "The reading CT-LIFE-1 takes, and the remedy is narrower still. The rule reads one declared member, one declared state and one declared machine, all of which the corpus itself resolved, so an advisory period would measure a false-positive rate that the construction fixes at zero. What it refuses is repaired by putting the file back, which is mechanical and total, so there is no judgment for an author to make and nothing for a posture to soften. A corpus that means to delete the record declares that member false on that regime, which is the escape this rule reads rather than one it overrides"
  CT-LANG-1:
    mechanism: "check:language.controlled.not_met"
    discharges:
      - OB-LANG-1
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      permanently_advisory:
        reasoning: "The same rule spec 4 states in general. A sentence past the word limit is shortened by deciding which clause carries the meaning, and no mechanical rewrite makes that decision"
  CT-LANG-2:
    mechanism: "check:language.source_form.not_met"
    discharges:
      - OB-LANG-2
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      criteria:
        window: "one release of the taxonomy over an adopting corpus"
        threshold: "no false positive, because the parser reports the break rather than a rule inferring it from a line count"
        sample: "every finding of one run over the adopting corpus, adjudicated once"
  CT-LANG-3:
    mechanism: "check:language.retired_term.used"
    discharges:
      - OB-LANG-3
    trigger: pull_request
    posture: advisory
    acts: detective
    promotion:
      criteria:
        window: "one release of the taxonomy over an adopting corpus"
        threshold: "no false positive on an entry that names a replacement, which is the half that is a substitution"
        sample: "every finding of one run over the adopting corpus, adjudicated once"
  CT-SECT-1:
    mechanism: "check:section.required.missing"
    discharges:
      - OB-SECT-1
    trigger: pull_request
    posture: advisory
    acts: detective
  CT-LINK-1:
    mechanism: "check:link.fragment.unresolved"
    discharges:
      - OB-LINK-1
    trigger: pull_request
    posture: advisory
    acts: detective

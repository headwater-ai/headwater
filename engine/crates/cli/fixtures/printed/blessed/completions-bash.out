_headwater() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="headwater"
                ;;
            headwater,capture)
                cmd="headwater__subcmd__capture"
                ;;
            headwater,change)
                cmd="headwater__subcmd__change"
                ;;
            headwater,check)
                cmd="headwater__subcmd__check"
                ;;
            headwater,completions)
                cmd="headwater__subcmd__completions"
                ;;
            headwater,conformance)
                cmd="headwater__subcmd__conformance"
                ;;
            headwater,derived)
                cmd="headwater__subcmd__derived"
                ;;
            headwater,explain)
                cmd="headwater__subcmd__explain"
                ;;
            headwater,export)
                cmd="headwater__subcmd__export"
                ;;
            headwater,gate)
                cmd="headwater__subcmd__gate"
                ;;
            headwater,generate)
                cmd="headwater__subcmd__generate"
                ;;
            headwater,help)
                cmd="headwater__subcmd__help"
                ;;
            headwater,import)

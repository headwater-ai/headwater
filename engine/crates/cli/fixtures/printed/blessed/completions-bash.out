                ;;
            headwater__subcmd__taxonomy,vendor)
                cmd="headwater__subcmd__taxonomy__subcmd__vendor"
                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        headwater)
            opts="-V -h --root --version --wide --no-color --no-banner --help check change observe gate conformance derived site merge-driver route neighbors explain show query capture mcp new infer generate import export sweep probe init taxonomy json help completions"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --root)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        headwater__subcmd__capture)

# ---------------------------------------------------------------- gate

# A read set that `check` writes always lists the eight rules whose verdict is
# a predicate over the whole census, and the gate carries none of them. So the
# passing line holds a read set with those lines taken out, which is the only
# read set whose verdicts carry.
[gate-carries]
row = headwater gate
outcome = pass
tree = base
setup = headwater check --root . --now 2026-01-15 --read-set run.readset
setup = drop-lines run.readset "barrier "
run = gate --root . --now 2026-01-15 --read-set run.readset

[gate-barriers]
row = headwater gate
outcome = refuse
tree = base
setup = headwater check --root . --now 2026-01-15 --read-set run.readset
run = gate --root . --now 2026-01-15 --read-set run.readset

[gate-document-moved]

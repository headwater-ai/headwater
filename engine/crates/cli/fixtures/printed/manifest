outcome = refuse
tree = base
setup = headwater check --root . --now 2026-01-15 --read-set run.readset
setup = drop-lines run.readset "barrier "
setup = write docs/answers/context.md "---\nstatus: current\nsummary: The summary moved.\ntitle: Recovery context\n---\n\n# Recovery context\n\nThe text moved.\n"
run = gate --root . --now 2026-01-15 --read-set run.readset


#
# The command lines `tests/printed.rs` runs, and what each one covers.
#
# One section is one line. The test runs it over a fresh copy of its trees and
# compares standard output, standard error and the exit status with
# `blessed/<label>.out`, `blessed/<label>.err` and `blessed/<label>.status`.
# After a change that means to move what a command prints, record it with
#
#     HEADWATER_BLESS=1 cargo test -p headwater-cli --test printed
#
# and read the diff of `blessed/` before you commit it.
#
#   [label]     names the three blessed files: lower-case letters, digits, `-`
#   row         the command line of the survey table in HW-OBL-0132 this covers.
#               The test derives the rows from `headwater_verbs::VERBS`, and it
#               refuses a row that is not one and a `run` that is not its row
#   outcome     `pass` for exit 0 and `refuse` for exit 1. The test holds the
#               status to it, so a bless cannot record a refusal as a pass
#   only        why the row has no line of the other outcome. A row needs a
#               line of each outcome, or one line that states this
#   tree        the directories under `trees/` copied into the root, in order.
#               None is an empty root
#   setup       one step that shapes the root before the line runs, repeatable
#               and run in order: `headwater <words>` and `git <words>` are
#               held to exit 0 and what they print is not compared,
#               `write <path> <content>`, `remove <path>`, and
#               `drop-lines <path> <prefix>`
#   stdin       one quoted word fed to standard input. `%HH` is one byte
#   run         the words after `headwater`
#
# A word is a run of characters with no blank, or a double-quoted string with
# the escapes `\n`, `\t`, `\"` and `\\`.
#
# Every line that reads the clock passes `--now 2026-01-15`. No line passes
# `--wide`, so the width is 80. Every line names its root as `--root .`, so a
# printed root is relative. A line that would print the engine version moves
# at every release: `probe-plan` is the one line that does, and no other may
# be added without that cost being meant.

# ---------------------------------------------------------------- check

[check-clean]
row = headwater check
outcome = pass
tree = base
run = check --root . --now 2026-01-15

[check-strict-error]
row = headwater check
outcome = refuse
tree = base
setup = write docs/answers/broken.md "---\nstatus: nosuch\ntitle: Broken\n---\n\n# Broken\n"
run = check --root . --now 2026-01-15 --strict

[check-no-lock]
row = headwater check
outcome = refuse
tree = base
setup = remove .headwater/taxonomy.lock
run = check --root . --now 2026-01-15

# ---------------------------------------------------------------- change

[change-one-document]
row = headwater change
outcome = pass
tree = base
setup = git init -q
setup = git add -A
setup = git commit -q -m first
setup = write docs/answers/context.md "---\nstatus: current\nsummary: The summary moved.\ntitle: Recovery context\n---\n\n# Recovery context\n\nThe text moved.\n"
run = change --root . HEAD out

[change-unknown-revision]
row = headwater change
outcome = refuse
